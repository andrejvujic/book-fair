<Window x:Class="WPFClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient"
        xmlns:visitor="clr-namespace:WPFClient.Views.Visitor"
        xmlns:book="clr-namespace:WPFClient.Views.Book"
        xmlns:author="clr-namespace:WPFClient.Views.Author"
        xmlns:publisher="clr-namespace:WPFClient.Views.Publisher"
        mc:Ignorable="d"
        Title="Sajam Knjiga"
        Height="720"
        Width="1080"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Segoe UI Icons: https://learn.microsoft.com/en-us/windows/apps/design/style/segoe-ui-symbol-font -->

        <DockPanel>

            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File">

                    <MenuItem Header="New" InputGestureText="Ctrl+N" Click="NewMenuItem_Click" >
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE710;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <!--
                    Sve se automatski cuva? Ovo nam treba?

                    <MenuItem Header="Save" InputGestureText="Ctrl+S">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE74E;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    -->

                    <MenuItem Header="Open">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xED25;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>

                        <MenuItem Header="Posjetioci" InputGestureText="Ctrl+V" Click="VisitorsMenuItem_Click"/>
                        <MenuItem Header="Autori" InputGestureText="Ctrl+A" Click="AuthorsMenuItem_Click"/>
                        <MenuItem Header="Knjige" InputGestureText="Ctrl+B" Click="BooksMenuItem_Click"/>
                        <MenuItem Header="Izdavači" InputGestureText="Ctrl+P" Click="PublishersMenuItem_Click"/>

                        <MenuItem Header="Izlaz" Click="ExitMenuItem_Click">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE711;"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                </MenuItem>

                <MenuItem Header="Edit">

                    <MenuItem Header="Izmjena entiteta" InputGestureText="Ctrl+E" Click="EditMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE70F;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Brisanje entiteta" InputGestureText="Ctrl+D" Click="DeleteMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE74D;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                </MenuItem>

                <MenuItem Header="Help">

                    <MenuItem Header="About" InputGestureText="Ctrl+H">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE946;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                </MenuItem>
            </Menu>

            <StatusBar DockPanel.Dock="Bottom"
                       Padding="16,0"
                       Height="32"
                       Background="LightGray">
                <StatusBarItem HorizontalContentAlignment="Stretch">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="CurrentTabIndicator" DockPanel.Dock="Left" Text="Sajam Knjiga"
                                   VerticalAlignment="Center"/>

                        <DockPanel />

                        <TextBlock x:Name="CurrentDateAndTime" DockPanel.Dock="Right" Text="Vrijeme"
                                   VerticalAlignment="Center"/>

                    </DockPanel>
                </StatusBarItem>
            </StatusBar>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,16,16,0">
                    <Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

					<Button Grid.Column="0"
                        Width="24"
                        Height="24"  Click="NewMenuItem_Click">
						<TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xECC8;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Button>

					<Button Grid.Column="2"
                        Width="24"
                        Height="24" Click="EditMenuItem_Click">
						<TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE70F;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Button>

					<Button Grid.Column="4"
                        Width="24"
                        Height="24" Click="DeleteMenuItem_Click">
						<TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE74D;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Button>

					<TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="6" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                    
                    <Button Grid.Column="8"
                        Width="24"
                        Height="24"
                        Click="SearchButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE721;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/> 
                    </Button>

                    <Button Grid.Column="10"
                        Width="24"
                        Height="24"
                        Click="ResetSearchButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE711;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <TabControl Grid.Row="1" x:Name="EntityTabs" Margin="16" SelectionChanged="EntityTabs_SelectionChanged">

                    <TabItem Header="Posjetioci">
                        <visitor:VisitorTab x:Name="VisitorTab" RawSearchQuery="{Binding VisitorsTabSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </TabItem>

                    <TabItem Header="Autori">
                        <Grid>
							<author:AuthorTab x:Name="AuthorTab"/>
						</Grid>
                    </TabItem>

                    <TabItem Header="Knjige">
                        <Grid>
                            <book:BookTab x:Name="BookTab"/>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
