<Window x:Class="WPFClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient"
        xmlns:visitor="clr-namespace:WPFClient.Views.Visitor"
        xmlns:book="clr-namespace:WPFClient.Views.Book"
        xmlns:author="clr-namespace:WPFClient.Views.Author"
        xmlns:publisher="clr-namespace:WPFClient.Views.Publisher"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization AppName}"
        Height="720"
        Width="1080"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <TextBlock x:Key="AppNameText" Text="{l:Localization AppName}" />
    </Window.Resources>
    <Grid>
        <!-- Segoe UI Icons: https://learn.microsoft.com/en-us/windows/apps/design/style/segoe-ui-symbol-font -->

        <DockPanel>

            <Menu DockPanel.Dock="Top">
                <MenuItem Header="{l:Localization File}">

                    <MenuItem Header="{l:Localization NewEntity}" InputGestureText="Ctrl+N" Click="NewMenuItem_Click" >
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE710;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <!--
                    Sve se automatski cuva? Ovo nam treba?

                    <MenuItem Header="{l:Localization Save} InputGestureText="Ctrl+S">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE74E;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    -->

                    <MenuItem Header="{l:Localization ViewEntities}">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xED25;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>

                        <MenuItem Header="{l:Localization Visitors}" InputGestureText="Ctrl+1" Click="VisitorsMenuItem_Click"/>
                        <MenuItem Header="{l:Localization Authors}" InputGestureText="Ctrl+2" Click="AuthorsMenuItem_Click"/>
                        <MenuItem Header="{l:Localization Books}" InputGestureText="Ctrl+3" Click="BooksMenuItem_Click"/>
                        <MenuItem Header="{l:Localization Publishers}" InputGestureText="Ctrl+4" Click="PublishersMenuItem_Click"/>
                    </MenuItem>

                    <MenuItem Header="{l:Localization Language}">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xF2B7;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>

                        <MenuItem Header="{l:Localization Serbian}" Click="SerbianMenuItem_Click">
                        </MenuItem>

                        <MenuItem Header="{l:Localization English}" Click="EnglishMenuItem_Click">
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{l:Localization Exit}" Click="ExitMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE711;"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{l:Localization Edit}">

                    <MenuItem Header="{l:Localization EditEntity}" InputGestureText="Ctrl+E" Click="EditMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE70F;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="{l:Localization DeleteEntity}" InputGestureText="Ctrl+D" Click="DeleteMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE74D;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                </MenuItem>

                <MenuItem Header="{l:Localization Help}">

                    <MenuItem Header="{l:Localization About}" InputGestureText="Ctrl+H" Click="HelpMenuItem_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE946;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>

                </MenuItem>
            </Menu>

            <StatusBar DockPanel.Dock="Bottom"
                       Padding="16,0"
                       Height="32"
                       Background="LightGray">
                <StatusBarItem HorizontalContentAlignment="Stretch">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} — {1}">
                                    <Binding Source="{StaticResource AppNameText}" Path="Text" />
                                    <Binding Path="CurrentTabIdentifier" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <DockPanel />

                        <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentDateTimeText}" />

                    </DockPanel>
                </StatusBarItem>
            </StatusBar>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,16,16,0">
                    <Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

					<Button Grid.Column="0"
                        Width="24"
                        Height="24"  Click="NewMenuItem_Click" ToolTip="{l:Localization NewEntity}">
						<TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xECC8;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Button>

					<Button Grid.Column="2"
                        Width="24"
                        Height="24" Click="EditMenuItem_Click" ToolTip="{l:Localization EditEntity}">
						<TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE70F;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Button>

					<Button Grid.Column="4"
                        Width="24"
                        Height="24" Click="DeleteMenuItem_Click" ToolTip="{l:Localization DeleteEntity}">
						<TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE74D;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Button>

					<TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="6" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                    
                    <Button Grid.Column="8"
                        Width="24"
                        Height="24"
                        Click="SearchButton_Click" ToolTip="{l:Localization StartSearch}">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE721;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/> 
                    </Button>

                    <Button Grid.Column="10"
                        Width="24"
                        Height="24"
                        Click="ResetSearchButton_Click" ToolTip="{l:Localization ResetSearch}">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE711;"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <TabControl Grid.Row="1" x:Name="EntityTabs" Margin="16" SelectionChanged="EntityTabs_SelectionChanged">

                    <TabItem Header="{l:Localization Visitors}">
                        <visitor:VisitorTab x:Name="VisitorTab" RawSearchQuery="{Binding VisitorsTabSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </TabItem>

                    <TabItem Header="{l:Localization Authors}">
						<author:AuthorTab x:Name="AuthorTab" RawSearchQuery="{Binding AuthorsTabSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
					</TabItem>

                    <TabItem Header="{l:Localization Books}">
						<book:BookTab x:Name="BookTab" RawSearchQuery="{Binding BooksTabSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
					</TabItem>

                </TabControl>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
