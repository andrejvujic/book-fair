<Window x:Class="WPFClient.Views.Purchase.MakePurchase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Purchase"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization MakePurchaseWindowTitle}" Height="360" Width="480" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0"
               Content="{l:Localization TitleRequired}"
               VerticalAlignment="Center"/>

            <TextBox Grid.Row="0" Grid.Column="1"
                 Margin="0,4"
                 Text="{Binding Path=Purchase.Book.Title, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

            <Label Grid.Row="1" Grid.Column="0"
               Content="{l:Localization ISBNRequired}"
               VerticalAlignment="Center"/>

            <TextBox Grid.Row="1" Grid.Column="1"
                 Margin="0,4"
                 Text="{Binding Path=Purchase.Book.Isbn, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

            <Label Grid.Row="2" Grid.Column="0" Content="{l:Localization DateRequired}" VerticalAlignment="Center"/>
            <DatePicker
                Grid.Row="2" Grid.Column="1" Margin="0,4"
                SelectedDate="{Binding Path=Purchase.Date, UpdateSourceTrigger=PropertyChanged}"
            />

            <Label Grid.Row="3" Grid.Column="0"
               Content="{l:Localization RatingRequired}"
               VerticalAlignment="Center"/>

            <TextBox Grid.Row="3" Grid.Column="1"
                 Margin="0,4"
                 Text="{Binding Path=Purchase.RatingText, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="4" Grid.Column="0"
              Content="{l:Localization CommentRequired}"
              VerticalAlignment="Center"/>

            <TextBox Grid.Row="4" Grid.Column="1"
                Margin="0,4"
                Text="{Binding Path=Purchase.Comment, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                        Width="128"
                        Height="32"
                        Content="{l:Localization Cancel}"
                        IsCancel="True"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

                    <Button Grid.Column="2"
                        Width="128"
                        Height="32"
                        Content="{l:Localization Add}"
                        IsDefault="True"
                        Click="AddButton_Click"
                        IsEnabled="{Binding Purchase.AllFieldsValid}"/>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom"
               Padding="16,0"
               Height="32"
               Background="LightGray">
            <StatusBarItem>
                <TextBlock Text="{l:Localization FieldRequired}" VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>

        <DockPanel/>
    </DockPanel>
</Window>
