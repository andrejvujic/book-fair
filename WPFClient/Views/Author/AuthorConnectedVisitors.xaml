<Window x:Class="WPFClient.Views.Author.AuthorConnectedVisitors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Author"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization VisitorConnectedAuthorsWindowTitle}" Height="450" Width="900"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <TextBlock x:Key="AuthorConnectedVisitorsLabelText" Text="{l:Localization AuthorConnectedVisitors}" />
        <TextBlock x:Key="NumberOfVisitorsLabelText" Text="{l:Localization NumberOfVisitors}" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,16">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} {1}">
                    <Binding Path="Text" Source="{StaticResource AuthorConnectedVisitorsLabelText}" />
                    <Binding Path="Author.FullName"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="0" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <Button Grid.Column="2"
                Width="24"
                Height="24"
                Click="SearchButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE721;"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Button>

            <Button Grid.Column="4"
                Width="24"
                Height="24"
                Click="ResetSearchButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                Text="&#xE711;"
                FontSize="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Visitors}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single">
            <DataGrid.Columns>
				<DataGridTextColumn Header="{l:Localization MembershipCardNumber}" CanUserSort="False" Binding="{Binding MembershipCardNumber}" Width="*"/>
				<DataGridTextColumn Header="{l:Localization FirstName}" Binding="{Binding FirstName}" Width="*"/>
				<DataGridTextColumn Header="{l:Localization LastName}" Binding="{Binding LastName}" Width="*"/>
				<DataGridTextColumn Header="{l:Localization Status}" Binding="{Binding StatusText}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Address}" Binding="{Binding AddressText}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,16,0,0">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} — {1}">
                    <Binding Path="Text" Source="{StaticResource NumberOfVisitorsLabelText}" />
                    <Binding Path="Visitors.Count"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

    </Grid>
</Window>
