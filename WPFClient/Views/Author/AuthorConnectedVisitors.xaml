<Window x:Class="WPFClient.Views.Author.AuthorConnectedVisitors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Author"
        mc:Ignorable="d"
        Title="Prikaz posjetilaca" Height="450" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,16"
               Text="{Binding Author.FullName, StringFormat=Posjetioci koji na listi želja imaju knjige autora {0}}"
        />

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="0" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <Button Grid.Column="2"
                Width="24"
                Height="24"
                Click="SearchButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE721;"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Button>

            <Button Grid.Column="4"
                Width="24"
                Height="24"
                Click="ResetSearchButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                Text="&#xE711;"
                FontSize="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Visitors}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Broj Članske Karte" Binding="{Binding MembershipCardNumber}" Width="*"/>
                <DataGridTextColumn Header="Ime" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Kategorija" Binding="{Binding StatusText}" Width="Auto"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding AddressText}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,16,0,0"
               Text="{Binding Visitors.Count, StringFormat=Broj posjetilaca — {0}}"
        />
    </Grid>
</Window>
