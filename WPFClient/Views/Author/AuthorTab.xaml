<UserControl x:Class="WPFClient.Views.Author.AuthorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		     xmlns:l="clr-namespace:WPFClient.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <TextBlock x:Key="CurrentPageLabelText" Text="{l:Localization CurrentPage}" />
        <l:LocalizedDateTimeConverter x:Key="LocalizedDateTimeConverter" />
    </UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<DataGrid Grid.Row="0"
                  Margin="16"
				  AutoGenerateColumns="False"
                  x:Name="AuthorsDataGrid"
                  ItemsSource="{Binding Authors, RelativeSource={RelativeSource AncestorType=UserControl}}"
				  Sorting="AuthorsDataGrid_Sorting"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Single">

			<DataGrid.Columns>
                <DataGridTextColumn Header="{l:Localization ID}" Binding="{Binding Id}" Width="Auto" SortMemberPath="Id"/>
                <DataGridTextColumn Header="{l:Localization FirstName}" Binding="{Binding FirstName}" Width="*" SortMemberPath="FirstName"/>
                <DataGridTextColumn Header="{l:Localization LastName}" Binding="{Binding LastName}" Width="*" SortMemberPath="LastName"/>
                <DataGridTextColumn Header="{l:Localization IDCardNumber}" Binding="{Binding IdCardNumber}" Width="Auto" CanUserSort="False"/>
                <DataGridTextColumn Header="{l:Localization DateOfBirth}" Width="Auto" CanUserSort="False">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource LocalizedDateTimeConverter}">
                            <Binding Path="DateOfBirth" />
                            <Binding Source="{x:Static l:TranslationSource.Instance}" Path="CurrentCulture" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{l:Localization Email}" Binding="{Binding Email}" Width="*" SortMemberPath="Email"/>
			</DataGrid.Columns>
		</DataGrid>


		<Grid Grid.Row="1" Margin="16,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0"
					Width="128"
					Height="32"
					Content="{l:Localization PreviousPage}"
					Click="PreviousPageButton_Click"
					IsEnabled="{Binding AuthorController.PreviousPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            
			<TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} — {1}">
                        <Binding Source="{StaticResource CurrentPageLabelText}" Path="Text" />
                        <Binding Path="AuthorController.CurrentPageText" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

			<Button Grid.Column="2"
					Width="128"
					Height="32"
					Content="{l:Localization NextPage}"
					Click="NextPageButton_Click"
					IsEnabled="{Binding AuthorController.NextPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
		</Grid>

        <Separator Grid.Row="2" Margin="16,0" Height="32"/>

        <Grid Grid.Row="3" Margin="16,0,16,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0"
					Width="128"
					Height="32"
					Content="{l:Localization ShowVisitors}"
					Click="OpenVisitorsWindowButton_Click"/>
		</Grid>

	</Grid>
</UserControl>