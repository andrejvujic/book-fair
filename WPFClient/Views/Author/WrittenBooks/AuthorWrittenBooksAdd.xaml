<Window x:Class="WPFClient.Views.Author.WrittenBooks.AuthorWrittenBooksAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Author.WrittenBooks"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization AddBook}"
        Height="384"
        Width="480"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <TextBlock x:Key="NumberOfBooksWihoutAuthorsLabelText" Text="{l:Localization NumberOfBooksWihoutAuthors}" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} — {1}">
                    <Binding Path="Text" Source="{StaticResource NumberOfBooksWihoutAuthorsLabelText}" />
                    <Binding Path="AllowedBooks.Count" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <DataGrid Grid.Row="2"
           AutoGenerateColumns="False"
           x:Name="AllowedBooksDataGrid"
           ItemsSource="{Binding AllowedBooks}"
           CanUserAddRows="False"
           IsReadOnly="True"
           HeadersVisibility="Column"
           SelectionUnit="FullRow"
           SelectionMode="Extended">
            <DataGrid.Columns>
				<DataGridTextColumn Header="{l:Localization ISBN}" Width="Auto" Binding="{Binding Isbn}"/>
				<DataGridTextColumn Header="{l:Localization Title}" Width="*" Binding="{Binding Title}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
             Width="128"
             Height="32"
             Content="{l:Localization Cancel}"
             IsCancel="True"/>

            <Button Grid.Column="3"
             Width="128"
             Height="32"
             Content="{l:Localization Add}"
             IsDefault="True"
             Click="AddButton_Click"/>
        </Grid>
    </Grid>
</Window>
