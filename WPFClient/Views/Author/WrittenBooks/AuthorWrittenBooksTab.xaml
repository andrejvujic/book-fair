<UserControl x:Class="WPFClient.Views.Author.WrittenBooks.AuthorWrittenBooksTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFClient.Views.Author.WrittenBooks"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                 Width="128"
                 Height="32"
                 Content="Dodaj"
                 Click="AddButton_Click"/>

            <Button Grid.Column="2"
                 Width="128"
                 Height="32"
                 Content="Obriši"
                 Click="DeleteButton_Click"/>

        </Grid>

        <Grid Grid.Row="1">
            <DataGrid Grid.Row="1"
               VerticalAlignment="Top"
               Margin="16,0,16,16"
               AutoGenerateColumns="False"
               x:Name="WrittenBooksDataGrid"
               ItemsSource="{Binding WrittenBooks, RelativeSource={RelativeSource AncestorType=UserControl}}"
               CanUserAddRows="False"
               IsReadOnly="True"
               HeadersVisibility="Column"
               SelectionUnit="FullRow"
               SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ISBN" Width="Auto" Binding="{Binding Isbn}"/>
                    <DataGridTextColumn Header="Naziv" Width="*" Binding="{Binding Title}"/>
                    <DataGridTextColumn Header="Godina izdanja" Binding="{Binding ReleaseYear}" Width="Auto"/>
                    <DataGridTextColumn Header="Žanr" Binding="{Binding GenreText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
