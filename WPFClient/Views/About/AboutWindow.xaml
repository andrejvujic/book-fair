<Window x:Class="WPFClient.Views.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.About"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization About}" Height="512" Width="640" WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

		<TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" Text="{l:Localization Introduction}">
		</TextBlock>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Andrej Vujić" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/>

				<TextBlock Grid.Row="2" Margin="8,0" TextAlignment="Center" TextWrapping="Wrap" Text="{l:Localization AndrejBiography}"/>
                

                <TextBlock Grid.Row="4" TextAlignment="Center">
                    <Hyperlink NavigateUri="mailto:vujic.ra130.2023@uns.ac.rs">
                        vujic.ra130.2023@uns.ac.rs
                    </Hyperlink>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Radovan Vitomirov" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/>

				<TextBlock Grid.Row="2" Margin="8,0" TextAlignment="Center" TextWrapping="Wrap" Text="{l:Localization RadovanBiography}"/>
                

                <TextBlock Grid.Row="4" TextAlignment="Center">
                    <Hyperlink NavigateUri="mailto:vujic.ra130.2023@uns.ac.rs">
                        vitormirov.ra132.2023@uns.ac.rs
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Grid>

        <Separator Grid.Row="2"  Height="16" />

		<TextBlock Grid.Row="3" Text="{l:Localization AppVersionText}" HorizontalAlignment="Center"/>
    </Grid>
</Window>
