<Window x:Class="WPFClient.Views.Visitor.WishlistedBooks.VisitorWishlistedBooksPurchase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dto="clr-namespace:WPFClient.DTO"
		d:DataContext="{d:DesignInstance Type=dto:BookDTO}"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Visitor.WishlistedBooks"
        mc:Ignorable="d"
        Title="Kupovina knjige"
        Height="320"
        Width="480"
        WindowStartupLocation="CenterOwner">


	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="140"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="12"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="12"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="12"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			
			<TextBlock Grid.Row="0" Grid.Column="0"
               Text="ISBN *"
               VerticalAlignment="Center"/>

			<TextBox Grid.Row="0" Grid.Column="1"
             x:Name="IsbnTextBox"
             IsReadOnly="True"
			 Text="{Binding Path=Book.Isbn, UpdateSourceTrigger=PropertyChanged}"/>

			<TextBlock Grid.Row="2" Grid.Column="0"
               Text="Naziv *"
               VerticalAlignment="Center"/>

			<TextBox Grid.Row="2" Grid.Column="1"
             IsReadOnly="True"
			 Text="{Binding Path=Book.Title, UpdateSourceTrigger=PropertyChanged}"/>

			<TextBlock Grid.Row="4" Grid.Column="0"
               Text="Ocena *"
               VerticalAlignment="Center"/>
			<TextBox Grid.Row="4" Grid.Column="1"/>

			<TextBlock Grid.Row="6" Grid.Column="0"
               Text="Datum kupovine *"
               VerticalAlignment="Center"/>
			<DatePicker Grid.Row="6" Grid.Column="1"
                x:Name="DatumKupovineDatePicker" />
		</Grid>

		<Grid Grid.Row="1" Margin="16,0,16,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<Button Grid.Column="1"
                    Width="128"
                    Height="32"
                    Content="Odustani"
                    IsCancel="True"/>

			<Button Grid.Column="3"
                    Width="128"
                    Height="32"
                    Content="Dodaj"
                    IsDefault="True"
                    Click="AddButton_Click"/>
		</Grid>
	</Grid>
</Window>
