<Window x:Class="WPFClient.Views.Visitor.WishlistedBooks.VisitorWishlistedBooksAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Visitor.WishlistedBooks"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization WishlistedBooksAddWindowTitle}"
        Height="480"
        Width="480"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="0" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            
            <Button Grid.Column="2"
                Width="24"
                Height="24"
                Click="SearchButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                            Text="&#xE721;"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
            </Button>

            <Button Grid.Column="4"
                Width="24"
                Height="24"
                Click="ResetSearchButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE711;"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  x:Name="AllowedBooksDataGrid"
                  ItemsSource="{Binding AllowedBooks}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Localization ISBN}" Width="Auto" Binding="{Binding Isbn}"/>
                <DataGridTextColumn Header="{l:Localization Title}" Width="*" Binding="{Binding Title}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Width="128"
                    Height="32"
                    Content="{l:Localization Cancel}"
                    IsCancel="True"/>

            <Button Grid.Column="3"
                    Width="128"
                    Height="32"
                    Content="{l:Localization Add}"
                    Click="AddButton_Click"/>
        </Grid>
    </Grid>
</Window>
