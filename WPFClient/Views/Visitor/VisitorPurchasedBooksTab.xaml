<UserControl x:Class="WPFClient.Views.Visitor.VisitorPurchasedBooksTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFClient.Views.Visitor"
             mc:Ignorable="d" 
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Width="128"
                Height="32"
                Margin="16,16,0,0"
                Content="Poništi kupovinu"
                HorizontalAlignment="Left"
                Click="DeletePurchaseButton_Click"
        />

        <DataGrid Grid.Row="1"
            VerticalAlignment="Top"
            Margin="16"
            AutoGenerateColumns="False"
            x:Name="PurchasedBooksDataGrid"
            ItemsSource="{Binding Purchases, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >

            <DataGrid.Resources>
                <Style x:Key="DataGridContentCellCentering" TargetType="{x:Type DataGridCell}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Grid Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>

            <DataGrid.CellStyle>
                <Style BasedOn="{StaticResource DataGridContentCellCentering}" TargetType="DataGridCell"/>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Width="*" Binding="{Binding Book.Isbn}"/>
                <DataGridTextColumn Header="Naziv" Width="*" Binding="{Binding Book.Title}"/>
                <DataGridTemplateColumn Header="Autori" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Book.FirstAndLastNamesOfAllAuthors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="2,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Broj stranica" Width="Auto" Binding="{Binding Book.NumberOfPages}"/>
                <DataGridTextColumn Header="Izdavač" Width="*" Binding="{Binding Book.Publisher.Name}"/>
                <DataGridTextColumn Header="Cijena (RSD)" Width="Auto" Binding="{Binding Book.Price}"/>
                <DataGridTextColumn Header="Žanr" Width="*" Binding="{Binding Book.Genre}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                Text="{Binding AverageRating,
                       RelativeSource={RelativeSource AncestorType=local:VisitorPurchasedBooksTab},
                       StringFormat=Prosječna ocjena — {0:0.00}}"
            />


            <TextBlock Grid.Row="1"
                Text="{Binding TotalSpent,
                       RelativeSource={RelativeSource AncestorType=local:VisitorPurchasedBooksTab},
                       StringFormat=Ukupno potrošeno — {0} RSD}"
            />
        </Grid>

    </Grid>
</UserControl>
