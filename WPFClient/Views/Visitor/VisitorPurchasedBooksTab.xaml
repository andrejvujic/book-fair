<UserControl x:Class="WPFClient.Views.Visitor.VisitorPurchasedBooksTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFClient.Views.Visitor"
             xmlns:l="clr-namespace:WPFClient.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <TextBlock x:Key="AverageReviewRatingLabelText" Text="{l:Localization AverageReviewRating}" />
        <TextBlock x:Key="TotalSpentLabelText" Text="{l:Localization TotalSpent}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Width="128"
                Height="32"
                Margin="16,16,0,0"
                Content="{l:Localization CancelPurchase}"
                HorizontalAlignment="Left"
                Click="DeletePurchaseButton_Click"
        />

        <DataGrid Grid.Row="1"
            Margin="16"
            AutoGenerateColumns="False"
            x:Name="PurchasedBooksDataGrid"
            ItemsSource="{Binding Purchases, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >

            <DataGrid.Resources>
                <Style x:Key="DataGridContentCellCentering" TargetType="{x:Type DataGridCell}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Grid Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>

            <DataGrid.CellStyle>
                <Style BasedOn="{StaticResource DataGridContentCellCentering}" TargetType="DataGridCell"/>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Localization ISBN}" Width="Auto" Binding="{Binding Book.Isbn}"/>
                <DataGridTextColumn Header="{l:Localization Title}" Width="*" Binding="{Binding Book.Title}"/>
                <DataGridTemplateColumn Header="{l:Localization Authors}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Book.FirstAndLastNamesOfAllAuthors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="2,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Localization Publisher}" Width="*" Binding="{Binding Book.Publisher.Name}"/>
                <DataGridTextColumn Header="{l:Localization Price}" Width="Auto" Binding="{Binding Book.Price}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="0,0,0,16" Grid.Row="0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} — {1:0.00}">
                        <Binding Path="Text" Source="{StaticResource AverageReviewRatingLabelText}"/>
                        <Binding Path="AverageRating" RelativeSource="{RelativeSource AncestorType=local:VisitorPurchasedBooksTab}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Margin="0,0,0,16" Grid.Row="1">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} — {1:0.00} RSD">
                        <Binding Path="Text" Source="{StaticResource TotalSpentLabelText}"/>
                        <Binding Path="TotalSpent" RelativeSource="{RelativeSource AncestorType=local:VisitorPurchasedBooksTab}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>

    </Grid>
</UserControl>
