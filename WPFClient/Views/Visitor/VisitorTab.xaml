<UserControl x:Class="WPFClient.Views.Visitor.VisitorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFClient.Views.Visitor"
             xmlns:l="clr-namespace:WPFClient.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <TextBlock x:Key="CurrentPageLabelText" Text="{l:Localization CurrentPage}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="360"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
        <DataGrid
            Grid.Row="0"
            Margin="16"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Visitors, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Sorting="VisitorsDataGrid_Sorting"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" SortMemberPath="Id"/>
                <DataGridTextColumn Header="{l:Localization MembershipCardNumber}" Width="Auto"  Binding="{Binding MembershipCardNumber}" SortMemberPath="MembershipCardNumber"/>
                <DataGridTextColumn Header="{l:Localization FirstName}" Width="*" Binding="{Binding FirstName}" SortMemberPath="FirstName"/>
                <DataGridTextColumn Header="{l:Localization LastName}" Width="*" Binding="{Binding LastName}" SortMemberPath="LastName"/>
                <DataGridTextColumn Header="{l:Localization Status}" Width="Auto" Binding="{Binding StatusText}" SortMemberPath="Status"/>
                <DataGridTextColumn Header="{l:Localization Address}" Width="*" Binding="{Binding AddressText}" CanUserSort="False"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                Width="128"
                Height="32"
                Content="{l:Localization PreviousPage}"
                Click="PreviousPageButton_Click"
                IsEnabled="{Binding VisitorController.PreviousPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} — {1}">
                        <Binding Source="{StaticResource CurrentPageLabelText}" Path="Text" />
                        <Binding Path="VisitorController.CurrentPageText" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Button Grid.Column="2"
                Width="128"
                Height="32"
                Content="{l:Localization NextPage}"
                Click="NextPageButton_Click"
                IsEnabled="{Binding VisitorController.NextPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>

		<Separator Grid.Row="2" Margin="16,0" Height="32"/>

		<Grid Grid.Row="3" Margin="16,0,16,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0"
					Width="128"
					Height="32"
                    Content="{l:Localization ShowAuthors}"
					Click="OpenAuthorsWindowButton_Click"/>
		</Grid>
	</Grid>
</UserControl>
