<UserControl x:Class="WPFClient.Views.Visitor.VisitorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFClient.Views.Visitor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
        <DataGrid
            Grid.Row="0"
            VerticalAlignment="Top"
            Margin="16"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Visitors, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Sorting="VisitorsDataGrid_Sorting"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" SortMemberPath="Id"/>
                <DataGridTextColumn Header="Broj Članske Karte" Width="Auto"  Binding="{Binding MembershipCardNumber}" SortMemberPath="MembershipCardNumber"/>
                <DataGridTextColumn Header="Ime" Width="*" Binding="{Binding FirstName}" SortMemberPath="FirstName"/>
                <DataGridTextColumn Header="Prezime" Width="*" Binding="{Binding LastName}" SortMemberPath="LastName"/>
                <DataGridTextColumn Header="Kategorija" Width="Auto" Binding="{Binding StatusText}" SortMemberPath="Status"/>
                <DataGridTextColumn Header="Adresa" Width="*" Binding="{Binding AddressText}" CanUserSort="False"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                Width="128"
                Height="32"
                Content="Prethodna"
                Click="PreviousPageButton_Click"
                IsEnabled="{Binding VisitorController.PreviousPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <TextBlock x:Name="CurrentPageIndicator" Grid.Column="1" Text="{Binding VisitorController.CurrentPageText, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Button Grid.Column="2"
                Width="128"
                Height="32"
                Content="Naredna"
                Click="NextPageButton_Click"
                IsEnabled="{Binding VisitorController.NextPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>

		<Separator Grid.Row="2" Margin="16,0" Height="32"/>

		<Grid Grid.Row="3" Margin="16,0,16,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0"
					Width="128"
					Height="32"
					Content="Prikaži autore"
					Click="OpenAuthorsWindowButton_Click"/>
		</Grid>
	</Grid>
</UserControl>
