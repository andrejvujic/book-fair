<UserControl x:Class="WPFClient.Views.Visitor.VisitorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFClient.Views.Visitor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid
            Grid.Row="0"
            VerticalAlignment="Top"
            Margin="16"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Visitors, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Sorting="VisitorsDataGrid_Sorting"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" SortMemberPath="Id"/>
                <DataGridTextColumn Header="Ime" Binding="{Binding FirstName}" SortMemberPath="FirstName"/>
                <DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" SortMemberPath="LastName"/>
                <DataGridTextColumn Header="Broj Telefona" Binding="{Binding PhoneNumber}" CanUserSort="False"/>
                <DataGridTextColumn Header="Email Adresa" Binding="{Binding EmailAddress}" CanUserSort="False"/>
                <DataGridTextColumn Header="Broj Članske Karte" Binding="{Binding MembershipCardNumber}" SortMemberPath="MembershipCardNumber"/>
                <DataGridTextColumn Header="Godina Članstva" Binding="{Binding MembershipYear}" SortMemberPath="MembershipYear"/>
                <DataGridTextColumn Header="Datum Rođenja" Binding="{Binding DateOfBirth, StringFormat={}{0:d/M/yyyy}}" CanUserSort="False"/>
                <DataGridTextColumn Header="Ketegorija" Binding="{Binding StatusText}" SortMemberPath="Status"/>
                <DataGridTextColumn Header="Prosjecna Ocjena Recenzija" Binding="{Binding AverageReviewRatingText}" SortMemberPath="AverageReviewRating"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding AddressText}" CanUserSort="False"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                Width="128"
                Height="32"
                Content="Prethodna"
                Click="PreviousPageButton_Click"
                IsEnabled="{Binding PreviousPageExists, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <TextBlock x:Name="CurrentPageIndicator" Grid.Column="1"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Button Grid.Column="2"
                Width="128"
                Height="32"
                Content="Naredna"
                Click="NextPageButton_Click"
                IsEnabled="{Binding NextPageExists, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>
    </Grid>
</UserControl>
