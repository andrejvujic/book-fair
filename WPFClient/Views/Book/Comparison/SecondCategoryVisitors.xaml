<UserControl x:Class="WPFClient.Views.Book.Comparison.SecondCategoryVisitors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFClient.Views.Book.Comparison"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                       Text="&#xE721;"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
            />

            <TextBox Grid.Column="2" Text="{Binding Path=RawSearchQuery, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Width="384" HorizontalAlignment="Left" TextChanged="Search_TextChanged"/>
        </Grid>

        <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                x:Name="VisitorsDataGrid"
                ItemsSource="{Binding Visitors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CanUserAddRows="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                SelectionUnit="FullRow"
                SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Broj Članske Karte" Binding="{Binding MembershipCardNumber}" Width="*"/>
                <DataGridTextColumn Header="Ime" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Kategorija" Binding="{Binding StatusText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="0,16,0,16"
                   Text="{Binding Visitors.Count, RelativeSource={RelativeSource AncestorType=UserControl},
                          StringFormat=Broj posjetilaca — {0}}"
        />
    </Grid>
</UserControl>
