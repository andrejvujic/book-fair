<Window x:Class="WPFClient.Views.Book.UpdateBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Book"
        xmlns:dto="clr-namespace:WPFClient.DTO"
        xmlns:gm="clr-namespace:WPFClient.Views.Book.GenreMapping"
        d:DataContext="{d:DesignInstance Type=dto:BookDTO}"
        mc:Ignorable="d"
        Title="Izmjena knjige"
        Height="640"
        Width="480"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="ISBN*" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.Isbn, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Naziv*" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.Title, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Žanr*" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" 
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                ItemsSource="{Binding Source={x:Static gm:GenreValues.All}}"
                SelectedValue="{Binding Path=Book.Genre, UpdateSourceTrigger=PropertyChanged}"
            />

            <Label Grid.Row="3" Grid.Column="0" Content="Izdavač*" VerticalAlignment="Center"/>
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                  Margin="0,4"
                  IsReadOnly="True"
                  Text="{Binding Path=Book.Publisher.Name}"/>

                <Button Grid.Column="2"
                    Width="24"
                    Height="24"
                    Click="SelectPublisherButton_Click"
                    IsEnabled="{Binding Path=Book.HasntGotPublisher}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE710;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>

                <Button Grid.Column="4"
                    Width="24"
                    Height="24"
                    Click="DeselectPublisherButton_Click"
                    IsEnabled="{Binding Path=Book.HasGotPublisher}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE738;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <Label Grid.Row="4" Grid.Column="0" Content="Godina izdanja*" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.ReleaseYear, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="5" Grid.Column="0" Content="Cijena (RSD)*" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.Price, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="6" Grid.Column="0" Content="Broj stranica*" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.NumberOfPages, UpdateSourceTrigger=PropertyChanged}"/>

			<Label Grid.Row="7" Grid.Column="0" Content="Autor*" VerticalAlignment="Center"/>
			<Grid Grid.Row="7" Grid.Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBox Grid.Column="0"
                         Margin="0,4"
                         IsReadOnly="True"
                         Text="{Binding Path=Book.FirstAuthorFullName, Mode=OneWay}"/>

				<Button Grid.Column="2"
                        Width="24"
                        Height="24"
                        Click="SelectAuthorButton_Click"
                        IsEnabled="{Binding Path=Book.HasntGotAuthors}">

					<TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE710;"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
				</Button>

				<Button Grid.Column="4"
                        Width="24"
                        Height="24"
                        Click="DeselectAuthorButton_Click"
                        IsEnabled="{Binding Path=Book.HasGotAuthors}">

					<TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE738;"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
				</Button>
			</Grid>
		</Grid>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Width="128"
                    Height="32"
                    Content="Otkaži"
                    IsCancel="True"/>

            <Button Grid.Column="3"
                    Width="128"
                    Height="32"
                    Content="Sačuvaj"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    IsEnabled="{Binding Book.AllFieldsValid}"/>
        </Grid>
    </Grid>
</Window>
