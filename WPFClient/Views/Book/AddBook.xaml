<Window x:Class="WPFClient.Views.Book.AddBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Book"
        xmlns:l="clr-namespace:WPFClient.Localization"
        xmlns:gm="clr-namespace:WPFClient.Views.Book.GenreMapping"
        mc:Ignorable="d"
        Title="{l:Localization AddBook}"
        Height="640"
        Width="480"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

			<Label Grid.Row="0" Grid.Column="0" Content="{l:Localization ISBNRequired}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.Isbn, UpdateSourceTrigger=PropertyChanged}"/>

			<Label Grid.Row="1" Grid.Column="0" Content="{l:Localization TitleRequired}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.Title, UpdateSourceTrigger=PropertyChanged}"/>

			<Label Grid.Row="2" Grid.Column="0" Content="{l:Localization GenreRequired}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" 
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                ItemsSource="{Binding Source={x:Static gm:GenreValues.All}}"
                SelectedValue="{Binding Path=Book.Genre, UpdateSourceTrigger=PropertyChanged}"
            />

			<Label Grid.Row="3" Grid.Column="0" Content="{l:Localization PublisherRequired}" VerticalAlignment="Center"/>
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                  Margin="0,4"
                  IsReadOnly="True"
                  Text="{Binding Path=Book.Publisher.Name}"/>

                <Button Grid.Column="2"
                    Width="24"
                    Height="24"
                    Click="SelectPublisherButton_Click"
                    IsEnabled="{Binding Path=Book.HasntGotPublisher}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE710;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>

                <Button Grid.Column="4"
                    Width="24"
                    Height="24"
                    Click="DeselectPublisherButton_Click"
                    IsEnabled="{Binding Path=Book.HasGotPublisher}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE738;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>
            </Grid>

			<Label Grid.Row="4" Grid.Column="0" Content="{l:Localization ReleaseYearRequired}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.ReleaseYearText, UpdateSourceTrigger=PropertyChanged}"/>

			<Label Grid.Row="5" Grid.Column="0" Content="{l:Localization PriceRequired}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.PriceText, UpdateSourceTrigger=PropertyChanged}"/>

			<Label Grid.Row="6" Grid.Column="0" Content="{l:Localization NumberOfPagesRequired}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1"
                     Margin="0,4"
                     Text="{Binding Path=Book.NumberOfPagesText, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="128"
                            Height="32"
                            Content="{l:Localization Cancel}"
                            IsCancel="True"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Width="128"
                            Height="32"
                            Content="{l:Localization Add}"
                            IsDefault="True"
                            Click="AddButton_Click"
                            IsEnabled="{Binding Book.AllFieldsValid}"/>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom"
                   Padding="16,0"
                   Height="32"
                   Background="LightGray">
            <StatusBarItem>
				<TextBlock Text="{l:Localization FieldRequired}" VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>

        <DockPanel/>
    </DockPanel>
</Window>
