<UserControl x:Class="WPFClient.Views.Book.BookTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFClient.Views.Book"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="128"
                    Height="32"
                    Margin="16"
                    Content="Poređenje knjiga"
                    Click="CompareButton_Click"/>

        </Grid>

        <DataGrid Grid.Row="1"
                  VerticalAlignment="Top"
                  Margin="16,0,16,16"
                  AutoGenerateColumns="False"
                  x:Name="BooksDataGrid"
                  ItemsSource="{Binding Books, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="*"/>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Žanr" Binding="{Binding Genre}" Width="*"/>
                <DataGridTextColumn Header="Godina izdanja" Binding="{Binding ReleaseYear}" Width="*"/>
                <DataGridTextColumn Header="Cijena" Binding="{Binding Price}" Width="*"/>
                <DataGridTextColumn Header="Broj stranica" Binding="{Binding NumberOfPages}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
