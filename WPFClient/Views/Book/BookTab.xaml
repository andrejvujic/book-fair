<UserControl x:Class="WPFClient.Views.Book.BookTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFClient.Views.Book"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  VerticalAlignment="Top"
                  Margin="16"
                  AutoGenerateColumns="False"
                  x:Name="BooksDataGrid"
                  ItemsSource="{Binding Books, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Sorting="BooksDataGrid_Sorting"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" SortMemberPath="Id"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding IsbnNumber}" Width="Auto" SortMemberPath="IsbnNumber"/>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Title}" Width="*" SortMemberPath="Title"/>
                <DataGridTextColumn Header="Godina izdanja" Binding="{Binding ReleaseYear}" Width="Auto" SortMemberPath="ReleaseYearNumber"/>
                <DataGridTextColumn Header="Cijena" Binding="{Binding Price}" Width="Auto" SortMemberPath="PriceNumber"/>
                <DataGridTextColumn Header="Žanr" Binding="{Binding GenreText}" Width="*" SortMemberPath="Genre"/>
            </DataGrid.Columns>
        </DataGrid>

		<Grid Grid.Row="1" Margin="16,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0"
			Width="128"
			Height="32"
			Content="Prethodna"
			Click="PreviousPageButton_Click"
			IsEnabled="{Binding BookController.PreviousPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

			<TextBlock x:Name="CurrentPageIndicator" Grid.Column="1" Text="{Binding BookController.CurrentPageText, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
               VerticalAlignment="Center" HorizontalAlignment="Center"/>

			<Button Grid.Column="2"
			Width="128"
			Height="32"
			Content="Naredna"
			Click="NextPageButton_Click"
			IsEnabled="{Binding BookController.NextPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
		</Grid>

		<Separator Grid.Row="2" Margin="16,0" Height="32"/>

		<Grid Grid.Row="3" Margin="16,0,16,16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" MinWidth="192" Text="{Binding FirstBookSelectionText}" VerticalAlignment="Center"/>
			<TextBlock Grid.Row="2" Grid.Column="0" MinWidth="192" Text="{Binding SecondBookSelectionText}" VerticalAlignment="Center"/>

			<Button Grid.Row="0" Grid.Column="2"
            Width="24"
            Height="24"
            IsEnabled="{Binding IsSelectFirstBookButtonEnabled}"
            Click="SelectFirstBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="&#xE710;"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="2" Grid.Column="2"
            Width="24"
            Height="24"
            IsEnabled="{Binding IsSelectSecondBookButtonEnabled}"
            Click="SelectSecondBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE710;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="0" Grid.Column="4"
            Width="24"
            Height="24"
            IsEnabled="{Binding IsDeselectFirstBookButtonEnabled}"
            Click="DeselectFirstBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE738;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="2" Grid.Column="4"
            Width="24"
            Height="24"
            IsEnabled="{Binding IsDeselectSecondBookButtonEnabled}"
            Click="DeselectSecondBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE738;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left"
            Width="128"
            Height="32"
            Content="Poređenje knjiga"
            Click="CompareButton_Click"/>
		</Grid>
	</Grid>
</UserControl>
