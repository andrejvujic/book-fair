<UserControl x:Class="WPFClient.Views.Book.BookTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFClient.Views.Book"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <DataGrid VerticalAlignment="Top"
                  Margin="16"
                  AutoGenerateColumns="False"
                  x:Name="BooksDataGrid"
                  ItemsSource="{Binding Books, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}"/>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Žanr" Binding="{Binding Genre}"/>
                <DataGridTextColumn Header="Godina izdanja" Binding="{Binding ReleaseYear}"/>
                <DataGridTextColumn Header="Cijena" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Broj stranica" Binding="{Binding NumberOfPages}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
