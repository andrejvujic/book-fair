<UserControl x:Class="WPFClient.Views.Book.BookTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFClient.Views.Book"
             xmlns:l="clr-namespace:WPFClient.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <TextBlock x:Key="CurrentPageLabelText" Text="{l:Localization CurrentPage}" />
        <l:LocalizedBookGenreConverter x:Key="LocalizedBookGenreConverter"/>
        <l:LocalizedBookSelectionTextConverter x:Key="LocalizedBookSelectionTextConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  Margin="16"
                  AutoGenerateColumns="False"
                  x:Name="BooksDataGrid"
                  ScrollViewer.CanContentScroll="False"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ItemsSource="{Binding Books, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Sorting="BooksDataGrid_Sorting"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Localization ID}" Binding="{Binding Id}" Width="Auto" SortMemberPath="Id"/>
                <DataGridTextColumn Header="{l:Localization ISBN}" Binding="{Binding Isbn}" Width="Auto" SortMemberPath="Isbn"/>
                <DataGridTextColumn Header="{l:Localization Title}" Binding="{Binding Title}" Width="*" SortMemberPath="Title"/>
                <DataGridTextColumn Header="{l:Localization ReleaseYear}" Binding="{Binding ReleaseYear}" Width="Auto" SortMemberPath="ReleaseYear"/>
                <DataGridTextColumn Header="{l:Localization Price}" Binding="{Binding Price}" Width="Auto" SortMemberPath="Price"/>
                <DataGridTextColumn Header="{l:Localization Genre}" Width="*" SortMemberPath="Genre">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource LocalizedBookGenreConverter}">
                            <Binding Path="Genre" />
                            <Binding Source="{x:Static l:TranslationSource.Instance}" Path="CurrentCulture" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

		<Grid Grid.Row="1" Margin="16,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                Width="128"
                Height="32"
                Content="{l:Localization PreviousPage}"
                Click="PreviousPageButton_Click"
                IsEnabled="{Binding BookController.PreviousPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} — {1}">
                        <Binding Source="{StaticResource CurrentPageLabelText}" Path="Text" />
                        <Binding Path="BookController.CurrentPageText" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Button Grid.Column="2"
                Width="128"
                Height="32"
                Content="{l:Localization NextPage}"
                Click="NextPageButton_Click"
                IsEnabled="{Binding BookController.NextPageExists, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
		</Grid>

		<Separator Grid.Row="2" Margin="16,0" Height="32"/>

		<Grid Grid.Row="3" Margin="16,0,16,16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="8"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>


            <TextBlock Grid.Row="0" Grid.Column="0" MinWidth="192" VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LocalizedBookSelectionTextConverter}" ConverterParameter="FirstBookNotSelected">
                        <Binding Path="FirstBook" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        <Binding Source="{x:Static l:TranslationSource.Instance}" Path="CurrentCulture" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Grid.Row="2" Grid.Column="0" MinWidth="192" VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LocalizedBookSelectionTextConverter}" ConverterParameter="SecondBookNotSelected">
                        <Binding Path="SecondBook" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        <Binding Source="{x:Static l:TranslationSource.Instance}" Path="CurrentCulture" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Button Grid.Row="0" Grid.Column="2"
                Width="24"
                Height="24"
                IsEnabled="{Binding IsSelectFirstBookButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="SelectFirstBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="&#xE710;"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="2" Grid.Column="2"
                Width="24"
                Height="24"
                IsEnabled="{Binding IsSelectSecondBookButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="SelectSecondBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE710;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="0" Grid.Column="4"
                Width="24"
                Height="24"
                IsEnabled="{Binding IsDeselectFirstBookButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="DeselectFirstBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE738;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="2" Grid.Column="4"
                Width="24"
                Height="24"
                IsEnabled="{Binding IsDeselectSecondBookButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="DeselectSecondBookButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE738;"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left"
                Width="128"
                Height="32"
                Content="{l:Localization CompareBooks}"
                Click="CompareButton_Click"/>
		</Grid>
	</Grid>
</UserControl>
