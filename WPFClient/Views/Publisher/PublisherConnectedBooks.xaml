<Window x:Class="WPFClient.Views.Publisher.PublisherConnectedBooks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Publisher"
        mc:Ignorable="d"
        Title="Prikaz knjiga" Height="450" Width="900"
		WindowStartupLocation="CenterOwner"
		>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Margin="0,0,0,16"
               Text="{Binding Publisher.Name, StringFormat=Knjige koje su izdate od strane izdavača {0}}"
        />

		<Grid Grid.Row="1" Margin="0,0,0,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="0" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
			<Button Grid.Column="2"
                Width="24"
                Height="24"
                Click="SearchButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE721;"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Column="4"
                Width="24"
                Height="24"
                Click="ResetSearchButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                Text="&#xE711;"
                FontSize="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
			</Button>
		</Grid>

		<DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Books}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Isbn" Binding="{Binding Isbn}" Width="Auto"/>
				<DataGridTextColumn Header="Naziv" Binding="{Binding Title}" Width="Auto"/>
				<DataGridTextColumn Header="Godina izdanja" Binding="{Binding ReleaseYear}" Width="Auto"/>
				<DataGridTextColumn Header="Cena" Binding="{Binding Price}" Width="Auto"/>
				<DataGridTextColumn Header="Žanr" Binding="{Binding Genre}" Width="*"/>
			</DataGrid.Columns>
		</DataGrid>

		<TextBlock Grid.Row="3" Margin="0,16,0,0"
               Text="{Binding Books.Count, StringFormat=Broj knjiga — {0}}"
        />

	</Grid>
</Window>
