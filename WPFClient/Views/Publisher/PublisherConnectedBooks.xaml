<Window x:Class="WPFClient.Views.Publisher.PublisherConnectedBooks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Publisher"
		xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization ViewBooks }" Height="450" Width="900"
		WindowStartupLocation="CenterOwner"
		>
	<Window.Resources>
		<l:LocalizedBookGenreConverter x:Key="LocalizedBookGenreConverter"/>
		<TextBlock x:Key="PublisherConnectedBooksLabelText" Text="{l:Localization PublisherConnectedBooks}" />
		<TextBlock x:Key="NumberOfBooksLabelText" Text="{l:Localization NumberOfBooks}" />
	</Window.Resources>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Margin="0,0,0,16">
			<TextBlock.Text>
				<MultiBinding StringFormat="{}{0} {1}">
					<Binding Path="Text" Source="{StaticResource PublisherConnectedBooksLabelText}" />
					<Binding Path="Publisher.Name"/>
				</MultiBinding>
			</TextBlock.Text>
		</TextBlock>

		<Grid Grid.Row="1" Margin="0,0,0,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="0" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
			<Button Grid.Column="2"
                Width="24"
                Height="24"
                Click="SearchButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE721;"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Column="4"
                Width="24"
                Height="24"
                Click="ResetSearchButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                Text="&#xE711;"
                FontSize="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
			</Button>
		</Grid>

		<DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Books}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTextColumn Header="{l:Localization ISBN}" Binding="{Binding Isbn}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Title}" Binding="{Binding Title}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization ReleaseYear}" Binding="{Binding ReleaseYear}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Price}" Binding="{Binding Price}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Genre}" Width="*">
				<DataGridTextColumn.Binding>
					<MultiBinding Converter="{StaticResource LocalizedBookGenreConverter}">
						<Binding Path="Genre" />
						<Binding Source="{x:Static l:TranslationSource.Instance}" Path="CurrentCulture" />
					</MultiBinding>
				</DataGridTextColumn.Binding>
				</DataGridTextColumn>
			</DataGrid.Columns>
		</DataGrid>

		<TextBlock Grid.Row="3" Margin="0,16,0,0">
			<TextBlock.Text>
				<MultiBinding StringFormat="{}{0} — {1}">
					<Binding Path="Text" Source="{StaticResource NumberOfBooksLabelText}" />
					<Binding Path="Books.Count"/>
				</MultiBinding>
			</TextBlock.Text>
		</TextBlock>

	</Grid>
</Window>
