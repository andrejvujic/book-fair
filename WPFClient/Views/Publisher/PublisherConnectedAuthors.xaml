<Window x:Class="WPFClient.Views.Publisher.PublisherConnectedAuthors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Publisher"
		xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization VisitorConnectedAuthorsWindowTitle}" Height="450" Width="900"
		WindowStartupLocation="CenterOwner"
		>
	<Window.Resources>
		<TextBlock x:Key="PublisherConnectedAuthorsLabelText" Text="{l:Localization PublisherConnectedAuthors}" />
		<TextBlock x:Key="NumberOfAuthorsLabelText" Text="{l:Localization NumberOfAuthors}" />
	</Window.Resources>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Margin="0,0,0,16">
			<TextBlock.Text>
				<MultiBinding StringFormat="{}{0} {1}">
					<Binding Path="Text" Source="{StaticResource PublisherConnectedAuthorsLabelText}" />
					<Binding Path="Publisher.Name"/>
				</MultiBinding>
			</TextBlock.Text>
		</TextBlock>

		<Grid Grid.Row="1" Margin="0,0,0,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="0" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
			<Button Grid.Column="2"
                Width="24"
                Height="24"
                Click="SearchButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE721;"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
			</Button>

			<Button Grid.Column="4"
                Width="24"
                Height="24"
                Click="ResetSearchButton_Click">
				<TextBlock FontFamily="Segoe MDL2 Assets"
                Text="&#xE711;"
                FontSize="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
			</Button>
		</Grid>

		<DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            x:Name="VisitorsDataGrid"
            ItemsSource="{Binding Authors}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTextColumn Header="{l:Localization FirstName}" Binding="{Binding FirstName}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization LastName}" Binding="{Binding LastName}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization DateOfBirth}" Binding="{Binding DateOfBirth}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Address}" Binding="{Binding AddressText}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization PhoneNumber}" Binding="{Binding PhoneNumber}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Email}" Binding="{Binding Email}" Width="*"/>
			</DataGrid.Columns>
		</DataGrid>

		<TextBlock Grid.Row="3" Margin="0,16,0,0">
			<TextBlock.Text>
				<MultiBinding StringFormat="{}{0} — {1}">
					<Binding Path="Text" Source="{StaticResource NumberOfAuthorsLabelText}" />
					<Binding Path="Authors.Count"/>
				</MultiBinding>
			</TextBlock.Text>
		</TextBlock>

	</Grid>
</Window>
