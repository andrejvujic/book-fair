<Window x:Class="WPFClient.Views.Publisher.SetPublisherBoss"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Publisher"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization SetBossPublisher}" Height="640" Width="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Column="0" Text="{Binding Path=RawSearchQuery, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <Button Grid.Column="2"
                Width="24"
                Height="24"
                Click="SearchButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                    Text="&#xE721;"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Button>

            <Button Grid.Column="4"
                Width="24"
                Height="24"
                Click="ResetSearchButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                Text="&#xE711;"
                FontSize="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            x:Name="AuthorsDataGrid"
            ItemsSource="{Binding Authors}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Localization ID}" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="{l:Localization FirstName}" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="{l:Localization LastName}" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="{l:Localization YearsOfExperience}" Binding="{Binding YearsOfExperience}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="4"
           Height="32" Width="128"
           HorizontalAlignment="Right"
           Content="{l:Localization SetBoss}"
           Click="SetAsBossButton_Click"/>
    </Grid>
</Window>