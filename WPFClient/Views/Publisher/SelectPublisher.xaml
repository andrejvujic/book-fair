<Window x:Class="WPFClient.Views.Publisher.SelectPublisher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Publisher"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization Publishers}" Height="640" Width="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="16,16,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid
            Grid.Row="0"
            AutoGenerateColumns="False"
            x:Name="PublishersDataGrid"
            ItemsSource="{Binding Publishers}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >
            <DataGrid.Columns>
				<DataGridTextColumn Header="{l:Localization ID}" Binding="{Binding Id}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Code}" Binding="{Binding Code}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Name}" Binding="{Binding Name}" Width="*"/>
				<DataGridTextColumn Header="{l:Localization Boss}" Binding="{Binding FullNameOfBoss}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                Width="128"
                Height="32"
                Content="{l:Localization Cancel}"
                IsCancel="True"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>

            <Button Grid.Column="3"
                Width="128"
                Height="32"
                Content="{l:Localization Select}"
                IsDefault="True"
                Click="SelectButton_Click"/>
        </Grid>
    </Grid>
</Window>
