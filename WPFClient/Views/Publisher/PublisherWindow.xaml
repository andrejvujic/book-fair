<Window x:Class="WPFClient.Views.Publisher.PublisherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFClient.Views.Publisher"
        xmlns:l="clr-namespace:WPFClient.Localization"
        mc:Ignorable="d"
        Title="{l:Localization Publishers}" Height="640" Width="480" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0"
                    Height="32"
                    Content="{l:Localization AddPublisher}"
                    Click="AddPublisherButton_Click"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Height="32"
                    Content="{l:Localization EditPublisher}"
                    Click="EditPublisherButton_Click"/>

            <Button Grid.Row="0" Grid.Column="4"
                    Height="32"
                    Content="{l:Localization DeletePublisher}"
                    Click="DeletePublisherButton_Click"/>

            <Button Grid.Row="2" Grid.Column="0"
                    Height="32"
                    Content="{l:Localization SetBoss}"
                    Click="SetBossButton_Click"/>

			<Button Grid.Row="2" Grid.Column="2"
                    Height="32"
                    Content="{l:Localization ShowAuthors}"
                    Click="OpenAuthorsWindowButton_Click"/>

			<Button Grid.Row="2" Grid.Column="4"
                    Height="32"
                    Content="{l:Localization ShowBooks}"
                    Click="OpenBooksWindowButton_Click"/>

		</Grid>

        <DataGrid
            Grid.Row="2"
            Margin="16,0,16,16"
            AutoGenerateColumns="False"
            x:Name="PublishersDataGrid"
            ItemsSource="{Binding Publishers}"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionUnit="FullRow"
            SelectionMode="Single"
        >
            <DataGrid.Columns>
				<DataGridTextColumn Header="{l:Localization ID}" Binding="{Binding Id}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Password}" Binding="{Binding Code}" Width="Auto"/>
				<DataGridTextColumn Header="{l:Localization Title}" Binding="{Binding Name}" Width="*"/>
				<DataGridTextColumn Header="{l:Localization Boss}" Binding="{Binding FullNameOfBoss}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
